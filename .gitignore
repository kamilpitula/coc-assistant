# .NET
**/bin/
**/obj/
*.user
*.suo

# Node
**/node_modules/
**/dist/
**/.vite/

# Playwright
e2e/playwright-report/
e2e/test-results/
e2e/logs/
e2e/blob-report/

# Authenticated-E2E harness: exported dev-cert PFX and its password file
e2e/.certs/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# The environment stacks keep their non-secret values in committed tfvars;
# never commit secrets in any tfvars file.
!infrastructure/terraform/environments/*.tfvars
# Never commit saved plans (for example bootstrap/bootstrap.plan).
infrastructure/terraform/**/*.plan

# Local configuration
.env
.env.*
!.env.example
!frontend/.env.e2e

# IDE
.vscode/settings.json
.idea/

# Test output
frontend/test-results/
e2e/e2e-out.txt
e2e/*.log
# actionlint binary cache (pin change invalidates it)
tools/actionlint/.cache/
# Handout files stored locally in development
backend/src/CocAssistant.Api/App_Data/
