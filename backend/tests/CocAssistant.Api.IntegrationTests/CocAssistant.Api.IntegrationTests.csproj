<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageReference Include="Respawn" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The adapter contract is written once in the Scenario Preparation tests and also run here against Azurite. -->
    <Compile Include="..\ScenarioPreparation\CocAssistant.ScenarioPreparation.Tests\HandoutFileStoreContract.cs" Link="Contracts\HandoutFileStoreContract.cs" />
    <Compile Include="..\ScenarioPreparation\CocAssistant.ScenarioPreparation.Tests\HandoutFileSamples.cs" Link="Contracts\HandoutFileSamples.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CocAssistant.Api\CocAssistant.Api.csproj" />
  </ItemGroup>

</Project>