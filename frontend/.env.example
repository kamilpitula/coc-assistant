# Copy to .env.local (gitignored) and fill in with values from the Entra External ID
# tenant/app registration set up per docs/entra-external-id-setup.md.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://<tenant>.ciamlogin.com/<tenant-id>
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_API_SCOPE=api://<api-client-id>/access_as_user
