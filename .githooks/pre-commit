#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
for tool in ascii-check backlog; do
  if [ ! -d "tools/$tool/node_modules" ]; then
    echo "pre-commit: run 'npm ci --prefix tools/$tool' first (fresh clone or worktree)" >&2
    exit 1
  fi
done
echo "pre-commit: ascii-check"
node tools/ascii-check/src/cli.ts
# Lint changed workflows and composite actions; actionlint has no runtime
# dependencies, so it stays out of the node_modules check above.
if git diff --cached --name-only | grep -Eq '^\.github/(workflows|actions)/'; then
  echo "pre-commit: actionlint"
  node tools/actionlint/src/cli.ts
fi
echo "pre-commit: backlog --check"
node tools/backlog/src/cli.ts --check
# Type-check staged frontend changes; `tsc --noEmit` in frontend/ checks nothing (root tsconfig has "files": []).
if git diff --cached --name-only | grep -q '^frontend/'; then
  if [ ! -d frontend/node_modules ]; then
    echo "pre-commit: frontend/node_modules missing, skipping typecheck (run 'npm ci' in frontend/)" >&2
  else
    echo "pre-commit: frontend typecheck"
    (cd frontend && npm run generate-routes --silent && npm run typecheck --silent)
  fi
fi
